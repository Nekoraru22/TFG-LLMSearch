CHROMA_DB_PATH=./data/chroma_db                                                         # Path to the ChromaDB database
TRACKED_FOLDER=./filesystem                                                             # Path to the folder that will be tracked for changes
CHROMA_COLLECTION_NAME=llm_search_collection                                            # Name of the collection in ChromaDB
LM_STUDIO_IP=192.168.1.137                                                              # IP address for the LM Studio server
LM_STUDIO_PORT=25565                                                                    # Port for the LM Studio server
LM_STUDIO_MODELS="jonahhenry/mistral-7b-instruct-v0.2.Q4_K_M-GGUF gemma-3-12b-it"       # Space-separated list of models to be used in LM Studio (First model is the default) (In linux use this format: LM_STUDIO_MODELS="model1 model2")
LM_STUDIO_MULTIMODAL_MODEL=gemma-3-12b-it                                               # Multimodal model to be used in LM Studio (for processing files)
LM_STUDIO_INITIAL_PROMPT=./data/initial_prompt.md                                       # Path to the initial prompt file for LM Studio (for processing files)
PREFECT_IP=192.168.1.137                                                                # IP address for the Prefect server
PREFECT_PORT=4200                                                                       # Port for the Prefect server
MODEL_WINDOW_LIMIT=4096                                                                 # Maximum token limit for the model window (for processing files)